# OpenAI API Key for message polishing
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Resend API Key for email sending
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email address to receive contact form submissions
# For testing: use the email associated with your Resend account
# For production: verify a domain at resend.com/domains and use that domain
CONTACT_EMAIL=

# Domain for sending emails (after verification)
# For testing: use onboarding@resend.dev
# For production: use your verified domain (e.g., contact@yourdomain.com)
FROM_EMAIL=onboarding@resend.dev

# Allowed domains for API access (comma-separated)
# For production: add your production domain(s)
# localhost and 127.0.0.1 are always allowed for development
# Example: yourdomain.com,www.yourdomain.com,yourdomain.vercel.app
ALLOWED_ORIGINS=
